# --- Secrets -------------------------------------------------------------
.env
.env.*
!.env.example

# --- Python --------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Data (generated at runtime; never commit user content) --------------
data/uploads/*
data/qdrant/*
data/cache/*
!data/uploads/.gitkeep
!data/qdrant/.gitkeep
!data/cache/.gitkeep

# Sample documents are generated by scripts/generate_sample_data.py,
# so keep them out of version control too.
data/sample_documents/*

# Keep the evaluation dataset in git (it is part of the project design).
!data/evaluation/
!data/evaluation/questions.json

# Model caches if HuggingFace cache is pointed inside the repo
models/
hf_cache/

# --- OS / editor ---------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/

# --- Logs ----------------------------------------------------------------
logs/
*.log
